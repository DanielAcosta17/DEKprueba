rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Public read for business branding and product photos
    // Authenticated administrators can upload files <= 5MB of type image/*
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
